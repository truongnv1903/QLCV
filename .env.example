# Local development (SQLite). Copy to .env; never commit .env.
APP_ENV=development
APP_URL=http://localhost:5173
DATABASE_URL=sqlite:///backend/data/laban.db
SESSION_DAYS=30
# Reset emails go to backend/dev-mailbox/ without SMTP in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=La Ban Cong Viec <noreply@example.com>
SMTP_STARTTLS=true

# Production: HTTPS public origin, secure cookies, PostgreSQL + SMTP required.
# APP_ENV=production
# APP_URL=https://tasks.example.com
# DATABASE_URL=postgresql+psycopg://laban:CHANGE_ME@postgres:5432/laban
# POSTGRES_PASSWORD=replace_with_long_random_alphanumeric_value
